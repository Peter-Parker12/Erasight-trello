generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider      = "postgresql"
  relationMode  = "prisma"
}

model Board {
  id               String    @id @default(uuid())
  orgId            String
  title            String
  imageId          String
  imageThumbUrl    String    @db.Text
  imageFullUrl     String    @db.Text
  imageUserName    String    @db.Text
  imageLinkHtml    String    @db.Text
  backgroundType   String    @default("image")
  backgroundColor  String?

  lists            List[]
  labels           Label[]
  boardMembers     BoardMember[]
  telegramConfig   BoardTelegramConfig?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model BoardTelegramConfig {
  id           String   @id @default(uuid())
  boardId      String   @unique
  botToken     String   @db.Text
  chatId       String
  topicId      String?
  reviewListId String?
  enabled      Boolean  @default(true)

  board        Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserTelegramAccount {
  id               String   @id @default(uuid())
  orgId            String
  userId           String
  telegramUsername String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([orgId])
}

model BoardMember {
  id        String @id @default(uuid())
  boardId   String
  userId    String
  userName  String @db.Text
  userImage String @db.Text

  board     Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
}

model List {
  id        String    @id  @default(uuid())
  title     String
  order     Int
  wipLimit  Int?

  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards     Card[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Card {
  id            String    @id @default(uuid())
  cardNumber    Int       @default(autoincrement())
  title         String
  order         Int
  description   String?   @db.Text
  priority      Priority  @default(NONE)
  startDate     DateTime?
  dueDate       DateTime?
  completed     Boolean   @default(false)
  coverColor    String?
  isTemplate    Boolean   @default(false)
  templateOrgId String?
  parentCardId  String?

  listId        String
  list          List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  parentCard    Card?     @relation("CardSubtasks", fields: [parentCardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subtasks      Card[]    @relation("CardSubtasks")

  labels        CardLabel[]
  members       CardMember[]
  checklists    Checklist[]
  comments      Comment[]
  attachments   Attachment[]
  watchers      CardWatcher[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([listId])
  @@index([parentCardId])
}

model Label {
  id      String  @id @default(uuid())
  name    String
  color   String
  boardId String
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards   CardLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model CardLabel {
  id      String @id @default(uuid())
  cardId  String
  labelId String

  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([cardId, labelId])
  @@index([cardId])
  @@index([labelId])
}

model Checklist {
  id     String @id @default(uuid())
  title  String
  order  Int    @default(0)
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  items  ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model ChecklistItem {
  id          String    @id @default(uuid())
  content     String    @db.Text
  completed   Boolean   @default(false)
  order       Int       @default(0)

  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistId])
}

model Comment {
  id        String @id @default(uuid())
  content   String @db.Text
  cardId    String
  orgId     String
  userId    String
  userName  String @db.Text
  userImage String @db.Text

  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model Attachment {
  id     String @id @default(uuid())
  name   String
  url    String @db.Text
  cardId String

  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cardId])
}

model CardMember {
  id        String @id @default(uuid())
  cardId    String
  userId    String
  userName  String @db.Text
  userImage String @db.Text

  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([cardId])
}

model CardWatcher {
  id        String @id @default(uuid())
  cardId    String
  userId    String

  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([cardId])
  @@index([userId])
}

model CardTemplate {
  id             String   @id @default(uuid())
  orgId          String
  title          String
  description    String?  @db.Text
  checklistsJson String?  @db.Text
  labelsJson     String?  @db.Text
  createdBy      String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId])
}

enum ACTION {
  CREATE
  UPDATE
  DELETE
}

enum ENTITY_TYPE {
  BOARD
  LIST
  CARD
  CHECKLIST
  CHECKLIST_ITEM
  COMMENT
  LABEL
  ATTACHMENT
}

model AuditLog {
  id          String      @id @default(uuid())
  orgId       String
  action      ACTION
  entityId    String
  entityType  ENTITY_TYPE
  entityTitle String
  userId      String
  userImage   String      @db.Text
  userName    String      @db.Text

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrgLimit {
  id        String    @id @default(uuid())
  orgId     String    @unique
  count     Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model OrgSubscription {
  id                     String    @id @default(uuid())
  orgId                  String    @unique

  stripeCustomerId       String?   @unique @map(name: "stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map(name: "stripe_subscription_id")
  stripePriceId          String?   @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map(name: "stripe_current_period_end")
}

enum NOTIFICATION_TYPE {
  CARD_ASSIGNED
  COMMENT_ADDED
  DUE_DATE_SOON
  CARD_UPDATED
  CARD_WATCHED_UPDATE
}

model Notification {
  id         String            @id @default(uuid())
  userId     String
  type       NOTIFICATION_TYPE
  read       Boolean           @default(false)
  message    String            @db.Text
  cardId     String?
  cardTitle  String?           @db.Text
  boardId    String?
  orgId      String
  actorName  String            @db.Text
  actorImage String            @db.Text

  createdAt  DateTime          @default(now())

  @@index([userId])
  @@index([orgId])
}
