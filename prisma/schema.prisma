generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider      = "postgresql"
  relationMode  = "prisma"
}

model Board {
  id               String    @id @default(uuid())
  orgId            String
  title            String
  imageId          String
  imageThumbUrl    String    @db.Text
  imageFullUrl     String    @db.Text
  imageUserName    String    @db.Text
  imageLinkHtml    String    @db.Text
  backgroundType   String    @default("image")
  backgroundColor  String?

  lists            List[]
  labels           Label[]
  boardMembers     BoardMember[]
  telegramConfig   BoardTelegramConfig?
  aiConfig         BoardAiConfig?
  transitionRules  ListTransitionRule[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model BoardTelegramConfig {
  id           String   @id @default(uuid())
  boardId      String   @unique
  botToken     String   @db.Text
  chatId       String
  topicId      String?
  reviewListId String?
  enabled      Boolean  @default(true)

  board        Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BoardAiConfig {
  id           String  @id @default(uuid())
  boardId      String  @unique
  reviewListId String?
  enabled      Boolean @default(true)

  board        Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ReviewSkill {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  description String
  prompt      String   @db.Text
  enabled     Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
}

model ReviewPartner {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  slug      String
  context   String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, slug])
  @@index([orgId])
}

model UserTelegramAccount {
  id               String   @id @default(uuid())
  orgId            String
  userId           String
  telegramUsername String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([orgId])
}

model UserDisplayName {
  id          String   @id @default(uuid())
  orgId       String
  userId      String
  displayName String   @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([orgId])
}

model BoardMember {
  id        String @id @default(uuid())
  boardId   String
  userId    String
  userName  String @db.Text
  userImage String @db.Text

  board     Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
}

enum ListType {
  STANDARD
  DONE
  FAILED
  CANCELLED
}

enum TransitionActionType {
  ADD_ASSIGNEE
  ADD_DUE_DATE
  ADD_REASON
}

model List {
  id             String               @id  @default(uuid())
  title          String
  order          Int
  wipLimit       Int?
  type           ListType             @default(STANDARD)

  boardId        String
  board          Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards          Card[]
  transitionRule ListTransitionRule?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([boardId])
}

model ListTransitionRule {
  id        String   @id @default(uuid())
  boardId   String
  listId    String   @unique
  actions   Json

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Card {
  id            String    @id @default(uuid())
  cardNumber    Int       @default(autoincrement())
  title         String
  order         Int
  description   String?   @db.Text
  reason        String?   @db.Text
  priority      Priority  @default(NONE)
  startDate     DateTime?
  dueDate       DateTime?
  reviewDeadline DateTime?
  completed     Boolean   @default(false)
  coverColor    String?
  isTemplate    Boolean   @default(false)
  templateOrgId String?
  parentCardId  String?

  listId        String
  list          List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  parentCard    Card?     @relation("CardSubtasks", fields: [parentCardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subtasks      Card[]    @relation("CardSubtasks")

  labels        CardLabel[]
  members       CardMember[]
  checklists    Checklist[]
  comments      Comment[]
  attachments   Attachment[]
  watchers      CardWatcher[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([listId])
  @@index([parentCardId])
}

model Label {
  id      String  @id @default(uuid())
  name    String
  color   String
  boardId String
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards   CardLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model CardLabel {
  id      String @id @default(uuid())
  cardId  String
  labelId String

  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([cardId, labelId])
  @@index([cardId])
  @@index([labelId])
}

model Checklist {
  id     String @id @default(uuid())
  title  String
  order  Int    @default(0)
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  items  ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model ChecklistItem {
  id          String    @id @default(uuid())
  content     String    @db.Text
  completed   Boolean   @default(false)
  order       Int       @default(0)

  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistId])
}

model Comment {
  id        String @id @default(uuid())
  content   String @db.Text
  imageUrl  String? @db.Text
  cardId    String
  orgId     String
  userId    String
  userName  String @db.Text
  userImage String @db.Text

  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model Attachment {
  id         String    @id @default(uuid())
  name       String
  url        String    @db.Text
  cardId     String
  review     String?   @db.Text
  reviewedAt DateTime?

  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cardId])
}

model CardMember {
  id        String @id @default(uuid())
  cardId    String
  userId    String
  userName  String @db.Text
  userImage String @db.Text

  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([cardId])
}

model CardWatcher {
  id        String @id @default(uuid())
  cardId    String
  userId    String

  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([cardId])
  @@index([userId])
}

model CardTemplate {
  id             String   @id @default(uuid())
  orgId          String
  title          String
  description    String?  @db.Text
  checklistsJson String?  @db.Text
  labelsJson     String?  @db.Text
  createdBy      String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId])
}

enum ACTION {
  CREATE
  UPDATE
  DELETE
}

enum ENTITY_TYPE {
  BOARD
  LIST
  CARD
  CHECKLIST
  CHECKLIST_ITEM
  COMMENT
  LABEL
  ATTACHMENT
  COMPANY
  CONTACT
  LEAD
  PRODUCT
  PRODUCT_BUNDLE
  KB_INDUSTRY
  KB_FOLDER
  KB_DOCUMENT
}

model AuditLog {
  id          String      @id @default(uuid())
  orgId       String
  action      ACTION
  entityId    String
  entityType  ENTITY_TYPE
  entityTitle String
  userId      String
  userImage   String      @db.Text
  userName    String      @db.Text

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}


enum NOTIFICATION_TYPE {
  CARD_ASSIGNED
  COMMENT_ADDED
  DUE_DATE_SOON
  CARD_UPDATED
  CARD_WATCHED_UPDATE
}

model Notification {
  id         String            @id @default(uuid())
  userId     String
  type       NOTIFICATION_TYPE
  read       Boolean           @default(false)
  message    String            @db.Text
  cardId     String?
  cardTitle  String?           @db.Text
  boardId    String?
  orgId      String
  actorName  String            @db.Text
  actorImage String            @db.Text

  createdAt  DateTime          @default(now())

  @@index([userId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Platform: module access (Taskify / CRM / future modules)
// ---------------------------------------------------------------------------

model ModuleAccess {
  id     String @id @default(uuid())
  orgId  String
  userId String
  module String

  createdAt DateTime @default(now())

  @@unique([orgId, userId, module])
  @@index([orgId, module])
}

// ---------------------------------------------------------------------------
// Platform: API keys for third-party access to the public API
// ---------------------------------------------------------------------------

model ApiKey {
  id         String    @id @default(uuid())
  orgId      String
  name       String
  keyPrefix  String
  hashedKey  String    @unique
  createdBy  String
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt  DateTime  @default(now())

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// CRM module
// ---------------------------------------------------------------------------

enum CrmEntityType {
  COMPANY
  CONTACT
  LEAD
  PRODUCT
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
  CURRENCY
  EMAIL
  PHONE
  URL
}

model CustomFieldDefinition {
  id         String          @id @default(uuid())
  orgId      String
  entityType CrmEntityType
  key        String
  label      String
  fieldType  CustomFieldType
  options    Json?
  required   Boolean         @default(false)
  order      Int             @default(0)

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([orgId, entityType, key])
  @@index([orgId, entityType])
}

model Company {
  id           String   @id @default(uuid())
  orgId        String
  name         String
  domain       String?
  industry     String?
  phone        String?
  website      String?  @db.Text
  address      String?  @db.Text
  description  String?  @db.Text
  customFields Json     @default("{}")

  contacts     Contact[]
  leads        Lead[]
  bundles      CompanyBundle[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
}

model Contact {
  id           String   @id @default(uuid())
  orgId        String
  firstName    String
  lastName     String?
  email        String?
  phone        String?
  title        String?
  customFields Json     @default("{}")

  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  leads        Lead[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@index([companyId])
}

model PipelineStage {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  order     Int
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)

  leads     Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model Lead {
  id           String         @id @default(uuid())
  orgId        String
  title        String
  order        Int
  value        Decimal?       @db.Decimal(14, 2)
  ownerId      String?
  customFields Json           @default("{}")

  stageId      String
  stage        PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  companyId    String?
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId    String?
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  products     LeadProduct[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([orgId])
  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// CRM: Products & Bundles
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum BundlePricingMode {
  SUM
  DISCOUNT_PERCENT
  DISCOUNT_FLAT
  FIXED
}

model Product {
  id           String        @id @default(uuid())
  orgId        String
  name         String
  description  String?       @db.Text
  category     String?
  categories   String[]      @default([])
  unitPrice    Decimal       @db.Decimal(15, 0)
  unit         String        @default("item")
  status       ProductStatus @default(ACTIVE)
  customFields Json          @default("{}")

  bundleItems  ProductBundleItem[]
  leads        LeadProduct[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orgId])
}

model ProductCategory {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  color     String   @default("#7c3aed")
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

model ProductBundle {
  id            String            @id @default(uuid())
  orgId         String
  name          String
  description   String?           @db.Text
  pricingMode   BundlePricingMode @default(SUM)
  discount      Decimal?          @db.Decimal(15, 0)
  finalPrice    Decimal?          @db.Decimal(15, 0)

  items         ProductBundleItem[] @relation("ParentBundle")
  childBundleOf ProductBundleItem[] @relation("ChildBundle")
  companies     CompanyBundle[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId])
}

model ProductBundleItem {
  id            String         @id @default(uuid())
  bundleId      String
  productId     String?
  childBundleId String?
  quantity      Int            @default(1)
  unitPrice     Decimal        @db.Decimal(15, 0)
  active        Boolean        @default(true)

  bundle        ProductBundle  @relation("ParentBundle", fields: [bundleId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  childBundle   ProductBundle? @relation("ChildBundle", fields: [childBundleId], references: [id], onDelete: SetNull)

  @@index([bundleId])
  @@index([productId])
  @@index([childBundleId])
}

model CompanyBundle {
  companyId  String
  bundleId   String
  assignedAt DateTime @default(now())

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bundle     ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@id([companyId, bundleId])
  @@index([companyId])
  @@index([bundleId])
}

model LeadProduct {
  leadId    String
  productId String
  createdAt DateTime @default(now())

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([leadId, productId])
  @@index([leadId])
  @@index([productId])
}

model KbIndustry {
  id          String     @id @default(uuid())
  orgId       String
  name        String
  description String?

  folders     KbFolder[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([orgId])
}

model KbFolder {
  id         String       @id @default(uuid())
  orgId      String
  industryId String
  name       String

  industry   KbIndustry   @relation(fields: [industryId], references: [id])
  documents  KbDocument[]

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([industryId])
  @@index([orgId])
}

model KbDocument {
  id          String   @id @default(uuid())
  orgId       String
  folderId    String
  name        String
  description String?
  url         String   @db.Text
  fileType    String?
  fileSize    Int?
  uploadedBy  String

  folder      KbFolder @relation(fields: [folderId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([folderId])
  @@index([orgId])
}
